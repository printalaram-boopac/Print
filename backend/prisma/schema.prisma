datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  DESIGNER
  PRINTER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  IN_PRODUCTION
  PRINTED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(uuid())
  firebaseUid  String        @unique  // Firebase Auth UID mapping
  email        String        @unique
  passwordHash String?       // Nullable if using third party auth like Firebase
  name         String
  phone        String?
  address      String?
  avatarUrl    String?
  role         Role          @default(CUSTOMER)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Structured shipping address
  shippingName  String?
  shippingPhone String?
  city          String?
  state         String?
  pincode       String?

  // Relations
  designs      CoverDesign[]
  orders       Order[]
  referrals    Referral[]    @relation("Referrer")
  referees     Referral[]    @relation("Referee")
  reviews      Review[]
  auditLogs    AuditLog[]
}

model CoverTemplate {
  id          String        @id @default(uuid())
  title       String
  description String?
  category    String        // e.g. "Wedding", "Festival", "Anniversary"
  price       Float         // Price per piece
  thumbnail   String        // URL of template image preview
  configJson  String        // Canvas / 3D setup configuration data stored as JSON
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relations
  designs      CoverDesign[]
}

model CoverDesign {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String?
  template    CoverTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title       String         // e.g. "My Wedding Envelope"
  customText  String?        // Custom greeting or name values
  configJson  String         // Customized Canvas / 3D configuration data as JSON
  previewUrl  String?        // Rendered thumbnail design image in Cloudinary
  theme       String?        // e.g. "Gold Luxury", "Royal Blue"
  occasion    String?        // e.g. "Wedding", "Birthday"
  photoUrl    String?        // Uploaded photo URL (Cloudinary)
  coupleName  String?        // Couple / person name for cover
  familyName  String?        // Family name for cover
  greetingText String?       // Greeting/blessing text for cover
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  orders      Order[]
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId       String?
  design         CoverDesign? @relation(fields: [designId], references: [id])
  quantity       Int
  unitPrice      Float
  totalAmount    Float
  shippingAddress String
  phone          String
  customerName   String?     // Denormalized for quick admin view
  coupleName     String?     // Names on the cover
  familyName     String?     // Family name on the cover
  greetingText   String?     // Greeting text on the cover
  occasion       String?     // e.g. "Wedding", "Birthday"
  theme          String?     // e.g. "Gold Luxury", "Royal Blue"
  isExpress      Boolean     @default(false)
  status         OrderStatus @default(PENDING)
  trackingNumber String?
  notes          String?     // Admin notes
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  payments       Payment[]
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount          Float
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Referral {
  id          String   @id @default(uuid())
  referrerId  String
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId   String   @unique
  referee     User     @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  rewardClaimed Boolean  @default(false)
  rewardAmount Float    @default(0.0)
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1 to 5
  comment   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "UPDATE_USER_ROLE", "DELETE_TEMPLATE"
  details   String   // e.g. "Updated User 123 role to Admin"
  ipAddress String?
  createdAt DateTime @default(now())
}

